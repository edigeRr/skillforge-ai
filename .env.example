# App
APP_NAME=SkillForge AI
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://skillforge:skillforge@db:5432/skillforge

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# AI Provider (fake | anthropic | openai)
# Defaults to "fake" so `docker compose up` works with zero API keys.
# Set to anthropic/openai + the matching key below to run real interviews.
AI_PROVIDER=fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:3000"]
